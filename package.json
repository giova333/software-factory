{
  "name": "software-factory",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal software factory: GitHub issues, PR comments and reviews in; agent-written commits and PRs out.",
  "type": "module",
  "bin": { "factory": "dist/cli.js" },
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp -r src/prompts dist/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "factory": "tsx src/cli.ts"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
