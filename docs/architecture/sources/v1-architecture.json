 "cards": [
  {
   "dot": "rose",
   "title": "Credential boundary",
   "items": [
    "The App token lives only in the factory process: Octokit calls and git push",
    "git gets the token per command via http extraheader, never in .git/config",
    "Claude Code and setup/test commands see PATH, HOME and the model key only"
   ]
  },
  {
   "dot": "cyan",
   "title": "Triggers",
   "items": [
    "Issue labelled factory, or /factory build on an issue: implement and open a draft PR",
    "/factory <instruction> on a PR: commit to its branch",
    "Changes-requested review on a factory/* branch: address it",
    "/factory plan: comment only"
   ]
  },
  {
   "dot": "emerald",
   "title": "Trust decisions",
   "items": [
    ".factory.yml is read from the default branch before auth",
    "Workflow allowlist overrides allowed_users",
    "Fork PRs and bot comments are refused"
   ]
  }
 ]
}