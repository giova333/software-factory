 "cards": [
  {
   "dot": "rose",
   "title": "What leaves the runner",
   "items": [
    "Repository code and issue text go to the Anthropic API as model context",
    "Commits and comments go to GitHub under the bot identity",
    "Prompt and transcript are kept 14 days as a workflow artifact"
   ]
  },
  {
   "dot": "emerald",
   "title": "What never reaches the agent",
   "items": [
    "The App private key stays in the workflow step",
    "The App token stays in the factory process and is passed to git per command",
    "sandboxEnv passes PATH, HOME, LANG, TERM and model keys only"
   ]
  },
  {
   "dot": "amber",
   "title": "Context the factory reads",
   "items": [
    "Issue body and comments (bot comments excluded)",
    "PR diff capped at 60,000 characters",
    "Review body and inline review comments for review-fix runs"
   ]
  }
 ]
