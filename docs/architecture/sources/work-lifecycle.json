 "cards": [
  {
   "dot": "cyan",
   "title": "Human gates",
   "items": [
    "The draft PR is the review gate; the factory never marks it ready or merges",
    "Every factory action needs a human trigger: label, /factory comment, or review",
    "A PR closed without merge simply ends the work; the branch stays"
   ]
  },
  {
   "dot": "amber",
   "title": "Retries",
   "items": [
    "No changes and failed runs are recoverable: comment /factory build again",
    "Re-runs reuse the same branch and PR"
   ]
  },
  {
   "dot": "slate",
   "title": "Main-path triggers",
   "items": [
    "label: issue labelled factory or /factory build",
    "start: the queued Actions run reaches a runner",
    "push: commits pushed, draft PR opened or reused",
    "reply: summary, test result and cost posted"
   ]
  }
 ]
